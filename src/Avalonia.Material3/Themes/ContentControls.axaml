<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="using:Avalonia.Data.Converters"
                    xmlns:t="using:Avalonia.Material3.Themes"
                    xmlns:c="using:Avalonia.Material3.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Avalonia.Material3/Themes/ContentTextTemplates.axaml" />
    <ResourceInclude Source="avares://Avalonia.Material3/Themes/ListItemTemplate.axaml" />
  </ResourceDictionary.MergedDictionaries>
  <t:ContentRoleTemplate x:Key="M3.Card.Title" Role="BodyLarge" AttenuateDisabledText="False" />
  <t:ContentRoleTemplate x:Key="M3.Card.Supporting" Role="BodyMedium" AttenuateDisabledText="False" />
  <t:ContentRoleTemplate x:Key="M3.Card.Label" Role="LabelSmall" AttenuateDisabledText="False" />
  <ControlTheme x:Key="{x:Type c:MaterialDivider}" TargetType="c:MaterialDivider">
    <Setter Property="Background" Value="{DynamicResource M3.OutlineVariantBrush}" />
    <Setter Property="Height" Value="{Binding StrokeThickness, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" Margin="{TemplateBinding LineInset}" /></ControlTemplate></Setter>
    <Style Selector="^:vertical"><Setter Property="Height" Value="NaN" /><Setter Property="Width" Value="{Binding StrokeThickness, RelativeSource={RelativeSource Self}}" /><Setter Property="HorizontalAlignment" Value="Center" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:MaterialBadge}" TargetType="c:MaterialBadge">
    <Setter Property="Background" Value="{DynamicResource M3.ErrorBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource M3.OnErrorBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource M3.LabelSmallFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource M3.LabelSmallFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource M3.LabelSmallFontWeight}" />
    <Setter Property="MinWidth" Value="6" /><Setter Property="MinHeight" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="CornerRadius" Value="{DynamicResource M3.Shape.CornerFull}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <TextBlock Text="{TemplateBinding DisplayText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     LineHeight="{DynamicResource M3.LabelSmallLineHeight}" LetterSpacing="{DynamicResource M3.LabelSmallLetterSpacing}"
                     IsVisible="{Binding Count, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:count"><Setter Property="MinWidth" Value="16" /><Setter Property="MinHeight" Value="16" /><Setter Property="Padding" Value="4,0" /></Style>
    <Style Selector="^:empty"><Setter Property="IsVisible" Value="False" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="M3.ContentItem" TargetType="c:MaterialContentItem">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource M3.BodyLargeFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource M3.BodyLargeFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource M3.BodyLargeFontWeight}" />
    <Setter Property="TitleTemplate" Value="{StaticResource M3.Content.Title}" />
    <Setter Property="SupportingContentTemplate" Value="{StaticResource M3.Content.Supporting}" />
    <Setter Property="OverlineTemplate" Value="{StaticResource M3.Content.Label}" />
    <Setter Property="TrailingTemplate" Value="{StaticResource M3.Content.Label}" />
    <Setter Property="ContentTemplate" Value="{StaticResource M3.Content.Title}" />
    <Setter Property="MinHeight" Value="48" /><Setter Property="Padding" Value="16,10" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <c:MaterialElevationBorder x:Name="Container" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="{DynamicResource M3.Elevation.Shadow0}" />
          <c:MaterialElevationBorder x:Name="Outline" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsHitTestVisible="False" />
          <c:MaterialStateLayer x:Name="StateLayer" Background="{TemplateBinding Foreground}" Opacity="0" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}" />
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="{TemplateBinding Padding}">
            <ContentPresenter x:Name="Leading" Content="{TemplateBinding Leading}" ContentTemplate="{TemplateBinding LeadingTemplate}" TextBlock.Foreground="{DynamicResource M3.OnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="{Binding Leading, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Image}" ContentTemplate="{TemplateBinding ImageTemplate}" VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="{Binding Image, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <ContentPresenter x:Name="Overline" Content="{TemplateBinding Overline}" ContentTemplate="{TemplateBinding OverlineTemplate}" TextBlock.Foreground="{DynamicResource M3.OnSurfaceVariantBrush}" IsVisible="{Binding Overline, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
              <ContentPresenter x:Name="Title" Content="{TemplateBinding Title}" ContentTemplate="{TemplateBinding TitleTemplate}" TextBlock.TextWrapping="Wrap" />
              <ContentPresenter x:Name="Supporting" Content="{TemplateBinding SupportingContent}" ContentTemplate="{TemplateBinding SupportingContentTemplate}" TextBlock.Foreground="{DynamicResource M3.OnSurfaceVariantBrush}" TextBlock.TextWrapping="Wrap" />
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" TextBlock.TextWrapping="Wrap" />
            </StackPanel>
            <ContentPresenter x:Name="Trailing" Grid.Column="3" Content="{TemplateBinding Trailing}" ContentTemplate="{TemplateBinding TrailingTemplate}" TextBlock.Foreground="{DynamicResource M3.OnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding Trailing, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
          </Grid>
          <Border x:Name="FocusRing" IsVisible="False" BorderBrush="{DynamicResource M3.SecondaryBrush}" BorderThickness="3" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:interactive:pointerover /template/ c|MaterialStateLayer#StateLayer"><Setter Property="Opacity" Value="{DynamicResource M3.HoverStateLayerOpacity}" /></Style>
    <Style Selector="^:focus-visible /template/ c|MaterialStateLayer#StateLayer"><Setter Property="Opacity" Value="{DynamicResource M3.FocusStateLayerOpacity}" /></Style>
    <Style Selector="^:pressed /template/ c|MaterialStateLayer#StateLayer"><Setter Property="Opacity" Value="{DynamicResource M3.PressedStateLayerOpacity}" /></Style>

    <Style Selector="^:selected"><Setter Property="Background" Value="{DynamicResource M3.SecondaryContainerBrush}" /><Setter Property="Foreground" Value="{DynamicResource M3.OnSecondaryContainerBrush}" /></Style>
    <Style Selector="^:selected /template/ ContentPresenter#Overline, ^:selected /template/ ContentPresenter#Supporting, ^:selected /template/ ContentPresenter#Leading, ^:selected /template/ ContentPresenter#Trailing"><Setter Property="TextBlock.Foreground" Value="{DynamicResource M3.OnSecondaryContainerBrush}" /></Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled)"><Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceBrush}" /></Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled) /template/ ContentPresenter#Overline, ^:disabled:not(:modal-paint-enabled) /template/ ContentPresenter#Supporting, ^:disabled:not(:modal-paint-enabled) /template/ ContentPresenter#Leading, ^:disabled:not(:modal-paint-enabled) /template/ ContentPresenter#Trailing"><Setter Property="TextBlock.Foreground" Value="{DynamicResource M3.OnSurfaceBrush}" /></Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled) /template/ c|MaterialStateLayer#StateLayer"><Setter Property="Opacity" Value="0" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:MaterialList}" TargetType="c:MaterialList">
    <Setter Property="CornerRadius" Value="{DynamicResource M3.Shape.CornerLarge}" />
    <Setter Property="Background" Value="{DynamicResource M3.SurfaceContainerLowBrush}" />
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:MaterialListItem}" TargetType="c:MaterialListItem" BasedOn="{StaticResource M3.ContentItem}">
    <Setter Property="Background" Value="{DynamicResource M3.SurfaceBrush}" /><Setter Property="CornerRadius" Value="{DynamicResource M3.Shape.CornerNone}" />
    <Setter Property="MinHeight" Value="56" /><Setter Property="Template" Value="{StaticResource M3.ListItemTemplate}" />
    <Setter Property="ExpandedContentTemplate" Value="{StaticResource M3.Content.Title}" />
    <Style Selector="^:two-line"><Setter Property="MinHeight" Value="72" /></Style>
    <Style Selector="^:three-line"><Setter Property="MinHeight" Value="88" /></Style>
    <Style Selector="^:expressive"><Setter Property="CornerRadius" Value="{DynamicResource M3.Shape.CornerExtraSmall}" /></Style>
    <Style Selector="^:expressive:pointerover"><Setter Property="CornerRadius" Value="{DynamicResource M3.Shape.CornerMedium}" /></Style>
    <Style Selector="^:expressive:pressed, ^:expressive:focus-visible, ^:expanded, ^:revealed"><Setter Property="CornerRadius" Value="{DynamicResource M3.Shape.CornerLarge}" /></Style>
    <Style Selector="^:selected"><Setter Property="CornerRadius" Value="{DynamicResource M3.Shape.CornerLarge}" /></Style>
    <Style Selector="^:expressive:disabled:not(:modal-paint-enabled)"><Setter Property="CornerRadius" Value="{DynamicResource M3.Shape.CornerExtraSmall}" /></Style>
    <Style Selector="^:selected:disabled:not(:modal-paint-enabled)"><Setter Property="Background" Value="{DynamicResource M3.OnSurfaceBrush}" /><Setter Property="CornerRadius" Value="{DynamicResource M3.Shape.CornerLarge}" /></Style>
    <Style Selector="^:selected:disabled:not(:modal-paint-enabled) /template/ Border#Container"><Setter Property="Opacity" Value="{DynamicResource M3.DisabledForegroundOpacity}" /></Style>
    <Style Selector="^:expanded /template/ c|MaterialSymbol#DisclosureIcon"><Setter Property="Symbol" Value="expand_less" /></Style>
    <Style Selector="^:reordering"><Setter Property="Background" Value="{DynamicResource M3.TertiaryContainerBrush}" /><Setter Property="Foreground" Value="{DynamicResource M3.OnTertiaryContainerBrush}" /><Setter Property="CornerRadius" Value="{DynamicResource M3.Shape.CornerLarge}" /></Style>
    <Style Selector="^:reordering /template/ Border#ElevationSurface"><Setter Property="BoxShadow" Value="{DynamicResource M3.Elevation.Shadow4}" /></Style>
    <Style Selector="^:reordering /template/ c|MaterialStateLayer#StateLayer"><Setter Property="Opacity" Value="{DynamicResource M3.DraggedStateLayerOpacity}" /></Style>
    <Style Selector="^:reordering /template/ ContentPresenter#Overline, ^:reordering /template/ ContentPresenter#Supporting"><Setter Property="TextBlock.Foreground" Value="{DynamicResource M3.OnTertiaryContainerBrush}" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:MaterialCard}" TargetType="c:MaterialCard" BasedOn="{StaticResource M3.ContentItem}">
    <Setter Property="TitleTemplate" Value="{StaticResource M3.Card.Title}" />
    <Setter Property="SupportingContentTemplate" Value="{StaticResource M3.Card.Supporting}" />
    <Setter Property="OverlineTemplate" Value="{StaticResource M3.Card.Label}" />
    <Setter Property="TrailingTemplate" Value="{StaticResource M3.Card.Label}" />
    <Setter Property="ContentTemplate" Value="{StaticResource M3.Card.Title}" />
    <Setter Property="Background" Value="{DynamicResource M3.SurfaceContainerHighestBrush}" /><Setter Property="CornerRadius" Value="{DynamicResource M3.Shape.CornerMedium}" /><Setter Property="Padding" Value="16" />
    <Style Selector="^:elevated"><Setter Property="Background" Value="{DynamicResource M3.SurfaceContainerLowBrush}" /></Style>
    <Style Selector="^:elevated /template/ Border#Container"><Setter Property="BoxShadow" Value="{DynamicResource M3.Elevation.Shadow1}" /></Style>
    <Style Selector="^:outlined"><Setter Property="Background" Value="{DynamicResource M3.SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource M3.OutlineVariantBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="^:interactive:pointerover:not(:outlined) /template/ Border#Container"><Setter Property="BoxShadow" Value="{DynamicResource M3.Elevation.Shadow1}" /></Style>
    <Style Selector="^:interactive:elevated:pointerover /template/ Border#Container"><Setter Property="BoxShadow" Value="{DynamicResource M3.Elevation.Shadow2}" /></Style>
    <Style Selector="^:selected"><Setter Property="Background" Value="{DynamicResource M3.SecondaryContainerBrush}" /></Style>
    <Style Selector="^:pressed /template/ Border#Container"><Setter Property="BoxShadow" Value="{DynamicResource M3.Elevation.Shadow0}" /></Style>
    <Style Selector="^:elevated:pressed /template/ Border#Container"><Setter Property="BoxShadow" Value="{DynamicResource M3.Elevation.Shadow1}" /></Style>
    <Style Selector="^:outlined:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource M3.OnSurfaceBrush}" /></Style>
    <Style Selector="^:dragged /template/ Border#Container"><Setter Property="BoxShadow" Value="{DynamicResource M3.Elevation.Shadow3}" /></Style>
    <Style Selector="^:elevated:dragged /template/ Border#Container"><Setter Property="BoxShadow" Value="{DynamicResource M3.Elevation.Shadow4}" /></Style>
    <Style Selector="^:dragged /template/ c|MaterialStateLayer#StateLayer"><Setter Property="Opacity" Value="{DynamicResource M3.DraggedStateLayerOpacity}" /></Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled)"><Setter Property="Background" Value="{DynamicResource M3.CardDisabledFilledContainerBrush}" /><Setter Property="Foreground" Value="{DynamicResource M3.CardDisabledForegroundBrush}" /></Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled) /template/ ContentPresenter#Overline, ^:disabled:not(:modal-paint-enabled) /template/ ContentPresenter#Supporting, ^:disabled:not(:modal-paint-enabled) /template/ ContentPresenter#Leading, ^:disabled:not(:modal-paint-enabled) /template/ ContentPresenter#Trailing"><Setter Property="TextBlock.Foreground" Value="{DynamicResource M3.CardDisabledForegroundBrush}" /></Style>
    <Style Selector="^:elevated:disabled:not(:modal-paint-enabled)"><Setter Property="Background" Value="{DynamicResource M3.SurfaceBrush}" /></Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled) /template/ Border#Container"><Setter Property="Opacity" Value="1" /><Setter Property="BoxShadow" Value="{DynamicResource M3.Elevation.Shadow0}" /></Style>
    <Style Selector="^:elevated:disabled:not(:modal-paint-enabled) /template/ Border#Container"><Setter Property="BoxShadow" Value="{DynamicResource M3.Elevation.Shadow1}" /></Style>
    <Style Selector="^:outlined:disabled:not(:modal-paint-enabled)"><Setter Property="Background" Value="{DynamicResource M3.SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource M3.CardDisabledOutlinedBorderBrush}" /></Style>
    <Style Selector="^:outlined:disabled:not(:modal-paint-enabled) /template/ Border#Container"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="^:outlined:disabled:not(:modal-paint-enabled) /template/ Border#Outline"><Setter Property="Opacity" Value="1" /></Style>
  </ControlTheme>
</ResourceDictionary>
