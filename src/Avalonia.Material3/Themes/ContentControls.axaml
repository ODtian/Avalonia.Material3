<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="using:Avalonia.Data.Converters"
                    xmlns:c="using:Avalonia.Material3.Controls"
                    xmlns:t="using:Avalonia.Material3.Themes">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Avalonia.Material3/Themes/ListItemTemplate.axaml" />
  </ResourceDictionary.MergedDictionaries>
  <!-- Fallbacks for the initial six-role theme. The full theme's own semantic resources take precedence. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="M3.SurfaceContainerHighestBrush" Color="#E6E0E9" />
      <SolidColorBrush x:Key="M3.SurfaceVariantBrush" Color="#E7E0EC" />
      <SolidColorBrush x:Key="M3.SurfaceContainerLowBrush" Color="#F7F2FA" />
      <SolidColorBrush x:Key="M3.SurfaceContainerBrush" Color="#F3EDF7" />
      <SolidColorBrush x:Key="M3.OutlineVariantBrush" Color="#CAC4D0" />
      <SolidColorBrush x:Key="M3.SecondaryBrush" Color="#625B71" />
      <SolidColorBrush x:Key="M3.SecondaryContainerBrush" Color="#E8DEF8" />
      <SolidColorBrush x:Key="M3.OnSecondaryContainerBrush" Color="#1D192B" />
      <SolidColorBrush x:Key="M3.TertiaryContainerBrush" Color="#FFD8E4" />
      <SolidColorBrush x:Key="M3.OnTertiaryContainerBrush" Color="#31111D" />
      <SolidColorBrush x:Key="M3.ErrorBrush" Color="#B3261E" />
      <SolidColorBrush x:Key="M3.OnErrorBrush" Color="White" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="M3.SurfaceContainerHighestBrush" Color="#36343B" />
      <SolidColorBrush x:Key="M3.SurfaceVariantBrush" Color="#49454F" />
      <SolidColorBrush x:Key="M3.SurfaceContainerLowBrush" Color="#211F26" />
      <SolidColorBrush x:Key="M3.SurfaceContainerBrush" Color="#2B2930" />
      <SolidColorBrush x:Key="M3.OutlineVariantBrush" Color="#49454F" />
      <SolidColorBrush x:Key="M3.SecondaryBrush" Color="#CCC2DC" />
      <SolidColorBrush x:Key="M3.SecondaryContainerBrush" Color="#4A4458" />
      <SolidColorBrush x:Key="M3.OnSecondaryContainerBrush" Color="#E8DEF8" />
      <SolidColorBrush x:Key="M3.TertiaryContainerBrush" Color="#633B48" />
      <SolidColorBrush x:Key="M3.OnTertiaryContainerBrush" Color="#FFD8E4" />
      <SolidColorBrush x:Key="M3.ErrorBrush" Color="#F2B8B5" />
      <SolidColorBrush x:Key="M3.OnErrorBrush" Color="#601410" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <t:ContentFontScaleConverter x:Key="M3.ContentLabelSmallFallback" />
  <ControlTheme x:Key="{x:Type c:MaterialDivider}" TargetType="c:MaterialDivider">
    <Setter Property="Background" Value="{DynamicResource M3.OutlineVariantBrush}" />
    <Setter Property="Height" Value="{Binding StrokeThickness, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" Margin="{TemplateBinding LineInset}" /></ControlTemplate></Setter>
    <Style Selector="^:vertical"><Setter Property="Height" Value="NaN" /><Setter Property="Width" Value="{Binding StrokeThickness, RelativeSource={RelativeSource Self}}" /><Setter Property="HorizontalAlignment" Value="Center" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:MaterialBadge}" TargetType="c:MaterialBadge">
    <Setter Property="Background" Value="{DynamicResource M3.ErrorBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource M3.OnErrorBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource M3.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource M3.BodyLargeFontSize}" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="CornerRadius" Value="1000" />
    <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><TextBlock Text="{TemplateBinding DisplayText}" FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource M3.ContentLabelSmallFallback}}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Count, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" /></Border></ControlTemplate></Setter>
    <Style Selector="^:count"><Setter Property="MinWidth" Value="16" /><Setter Property="MinHeight" Value="16" /><Setter Property="Padding" Value="4,0" /></Style>
    <Style Selector="^:empty"><Setter Property="IsVisible" Value="False" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="M3.ContentItem" TargetType="c:MaterialContentItem">
    <Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource M3.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource M3.BodyLargeFontSize}" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Border x:Name="Container" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
          <Border x:Name="Outline" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsHitTestVisible="False" />
          <Border x:Name="StateLayer" Background="{TemplateBinding Foreground}" Opacity="0" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}" />
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Leading}" ContentTemplate="{TemplateBinding LeadingTemplate}" VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="{Binding Leading, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Image}" ContentTemplate="{TemplateBinding ImageTemplate}" VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="{Binding Image, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <ContentPresenter x:Name="Overline" Content="{TemplateBinding Overline}" ContentTemplate="{TemplateBinding OverlineTemplate}" TextBlock.TextWrapping="Wrap" TextBlock.FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource M3.ContentLabelSmallFallback}}" TextBlock.Foreground="{DynamicResource M3.OnSurfaceVariantBrush}" IsVisible="{Binding Overline, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
              <ContentPresenter Content="{TemplateBinding Title}" ContentTemplate="{TemplateBinding TitleTemplate}" TextBlock.TextWrapping="Wrap" />
              <ContentPresenter x:Name="Supporting" Content="{TemplateBinding SupportingContent}" ContentTemplate="{TemplateBinding SupportingContentTemplate}" TextBlock.TextWrapping="Wrap" TextBlock.Foreground="{DynamicResource M3.OnSurfaceVariantBrush}" TextBlock.FontSize="{DynamicResource M3.LabelLargeFontSize}" />
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" TextBlock.TextWrapping="Wrap" />
            </StackPanel>
            <ContentPresenter Grid.Column="3" Content="{TemplateBinding Trailing}" ContentTemplate="{TemplateBinding TrailingTemplate}" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding Trailing, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
          </Grid>
          <Border x:Name="FocusRing" IsVisible="False" BorderBrush="{DynamicResource M3.SecondaryBrush}" BorderThickness="3" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:interactive:pointerover /template/ Border#StateLayer"><Setter Property="Opacity" Value="0.08" /></Style>
    <Style Selector="^:pressed /template/ Border#StateLayer"><Setter Property="Opacity" Value="0.1" /></Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:selected"><Setter Property="Background" Value="{DynamicResource M3.SecondaryContainerBrush}" /><Setter Property="Foreground" Value="{DynamicResource M3.OnSecondaryContainerBrush}" /></Style>
    <Style Selector="^:selected /template/ ContentPresenter#Overline"><Setter Property="TextBlock.Foreground" Value="{DynamicResource M3.OnSecondaryContainerBrush}" /></Style>
    <Style Selector="^:selected /template/ ContentPresenter#Supporting"><Setter Property="TextBlock.Foreground" Value="{DynamicResource M3.OnSecondaryContainerBrush}" /></Style>
    <Style Selector="^:disabled"><Setter Property="Foreground" Value="{DynamicResource M3.DisabledForegroundBrush}" /></Style>
    <Style Selector="^:disabled /template/ ContentPresenter#Overline"><Setter Property="TextBlock.Foreground" Value="{DynamicResource M3.DisabledForegroundBrush}" /></Style>
    <Style Selector="^:disabled /template/ ContentPresenter#Supporting"><Setter Property="TextBlock.Foreground" Value="{DynamicResource M3.DisabledForegroundBrush}" /></Style>
    <Style Selector="^:disabled /template/ Border#StateLayer"><Setter Property="Opacity" Value="0" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:MaterialList}" TargetType="c:MaterialList">
    <Setter Property="Background" Value="{DynamicResource M3.SurfaceContainerLowBrush}" />
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:MaterialListItem}" TargetType="c:MaterialListItem" BasedOn="{StaticResource M3.ContentItem}">
    <Setter Property="Background" Value="{DynamicResource M3.SurfaceBrush}" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Template" Value="{StaticResource M3.ListItemTemplate}" />
    <Style Selector="^:two-line"><Setter Property="MinHeight" Value="72" /></Style>
    <Style Selector="^:three-line"><Setter Property="MinHeight" Value="88" /></Style>
    <Style Selector="^:expressive"><Setter Property="CornerRadius" Value="4" /></Style>
    <Style Selector="^:expressive:pointerover"><Setter Property="CornerRadius" Value="12" /></Style>
    <Style Selector="^:expressive:pressed, ^:expressive:focus-visible, ^:expanded, ^:revealed"><Setter Property="CornerRadius" Value="16" /></Style>
    <Style Selector="^:selected"><Setter Property="CornerRadius" Value="16" /></Style>
    <Style Selector="^:expressive:disabled"><Setter Property="CornerRadius" Value="4" /></Style>
    <Style Selector="^:selected:disabled"><Setter Property="Background" Value="{DynamicResource M3.OnSurfaceBrush}" /><Setter Property="CornerRadius" Value="16" /></Style>
    <Style Selector="^:selected:disabled /template/ Border#Container"><Setter Property="Opacity" Value="0.38" /></Style>
    <Style Selector="^:reordering"><Setter Property="Background" Value="{DynamicResource M3.TertiaryContainerBrush}" /><Setter Property="Foreground" Value="{DynamicResource M3.OnTertiaryContainerBrush}" /><Setter Property="CornerRadius" Value="16" /></Style>
    <Style Selector="^:reordering /template/ Border#Container"><Setter Property="BoxShadow" Value="0 8 12 0 #33000000" /></Style>
    <Style Selector="^:expanded /template/ c|MaterialButton#PART_ExpandButton"><Setter Property="Background" Value="{DynamicResource M3.SurfaceContainerBrush}" /><Setter Property="Content" Value="⌃" /></Style>
    <Style Selector="^:reordering /template/ ContentPresenter#Overline"><Setter Property="TextBlock.Foreground" Value="{DynamicResource M3.OnTertiaryContainerBrush}" /></Style>
    <Style Selector="^:reordering /template/ ContentPresenter#Supporting"><Setter Property="TextBlock.Foreground" Value="{DynamicResource M3.OnTertiaryContainerBrush}" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type c:MaterialCard}" TargetType="c:MaterialCard" BasedOn="{StaticResource M3.ContentItem}">
    <Setter Property="Background" Value="{DynamicResource M3.SurfaceContainerHighestBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
    <Style Selector="^:elevated"><Setter Property="Background" Value="{DynamicResource M3.SurfaceContainerLowBrush}" /></Style>
    <Style Selector="^:elevated /template/ Border#Container"><Setter Property="BoxShadow" Value="0 1 2 0 #26000000" /></Style>
    <Style Selector="^:outlined"><Setter Property="Background" Value="{DynamicResource M3.SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource M3.OutlineVariantBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="^:interactive:pointerover /template/ Border#Container"><Setter Property="BoxShadow" Value="0 1 2 0 #26000000" /></Style>
    <Style Selector="^:interactive:elevated:pointerover /template/ Border#Container"><Setter Property="BoxShadow" Value="0 2 4 0 #26000000" /></Style>
    <Style Selector="^:selected"><Setter Property="Background" Value="{DynamicResource M3.SecondaryContainerBrush}" /></Style>
    <Style Selector="^:pressed /template/ Border#Container"><Setter Property="BoxShadow" Value="none" /></Style>
    <Style Selector="^:elevated:pressed /template/ Border#Container"><Setter Property="BoxShadow" Value="0 1 2 0 #26000000" /></Style>
    <Style Selector="^:outlined:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource M3.OnSurfaceBrush}" /></Style>
    <Style Selector="^:dragged /template/ Border#Container"><Setter Property="BoxShadow" Value="0 6 10 0 #33000000" /></Style>
    <Style Selector="^:elevated:dragged /template/ Border#Container"><Setter Property="BoxShadow" Value="0 8 12 0 #33000000" /></Style>
    <Style Selector="^:disabled"><Setter Property="Background" Value="{DynamicResource M3.SurfaceVariantBrush}" /></Style>
    <Style Selector="^:elevated:disabled"><Setter Property="Background" Value="{DynamicResource M3.SurfaceBrush}" /></Style>
    <Style Selector="^:disabled /template/ Border#Container"><Setter Property="Opacity" Value="0.38" /><Setter Property="BoxShadow" Value="none" /></Style>
    <Style Selector="^:elevated:disabled /template/ Border#Container"><Setter Property="BoxShadow" Value="0 1 2 0 #26000000" /></Style>
    <Style Selector="^:outlined:disabled"><Setter Property="Background" Value="{DynamicResource M3.SurfaceBrush}" /></Style>
    <Style Selector="^:outlined:disabled"><Setter Property="BorderBrush" Value="{DynamicResource M3.OutlineBrush}" /></Style>
    <Style Selector="^:outlined:disabled /template/ Border#Container"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="^:outlined:disabled /template/ Border#Outline"><Setter Property="Opacity" Value="0.12" /></Style>
  </ControlTheme>
</ResourceDictionary>
