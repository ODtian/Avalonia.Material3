<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Avalonia.Material3.Controls">
  <!-- All semantic roles and typography/state resources come from MaterialTheme (M3-02). -->
  <ControlTheme x:Key="M3.SelectionInteraction" TargetType="ToggleButton">
    <Setter Property="FontWeight" Value="{DynamicResource M3.BodyLargeFontWeight}" />
    <Style Selector="^ /template/ ContentPresenter">
      <Setter Property="LineHeight" Value="{DynamicResource M3.BodyLargeLineHeight}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource M3.BodyLargeLetterSpacing}" />
    </Style>
    <Style Selector="^ /template/ TextBlock#ErrorLabel">
      <Setter Property="LineHeight" Value="{DynamicResource M3.BodyLargeLineHeight}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource M3.BodyLargeLetterSpacing}" />
    </Style>
    <Style Selector="^:pointerover /template/ controls|MaterialStateLayer#StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource M3.HoverStateLayerOpacity}" />
    </Style>

    <Style Selector="^:focus-visible /template/ controls|MaterialStateLayer#StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource M3.FocusStateLayerOpacity}" />
    </Style>
    <Style Selector="^:pressed /template/ controls|MaterialStateLayer#StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource M3.PressedStateLayerOpacity}" />
    </Style>
    <Style Selector="^:dragging /template/ controls|MaterialStateLayer#StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource M3.DraggedStateLayerOpacity}" />
    </Style>
    <Style Selector="^:unchecked:pointerover, ^:unchecked:pressed, ^:unchecked:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource M3.OnSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled) /template/ controls|MaterialStateLayer#StateLayer">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled) /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled) /template/ TextBlock#ErrorLabel">
      <Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceBrush}" />
      <Setter Property="Opacity" Value="{DynamicResource M3.DisabledForegroundOpacity}" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled) /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceBrush}" />
      <Setter Property="Opacity" Value="{DynamicResource M3.DisabledForegroundOpacity}" />
    </Style>
  </ControlTheme>
  <!-- Pinned Checkbox.kt M3 stylingFix=true:18 canvas,2 stroke,40 state layer;48 target. -->
  <ControlTheme x:Key="{x:Type controls:MaterialCheckBox}" TargetType="controls:MaterialCheckBox" BasedOn="{StaticResource M3.SelectionInteraction}">
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource M3.OnSurfaceVariantBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource M3.BodyLargeFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource M3.BodyLargeFontSize}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="48,*" Background="Transparent">
          <Grid Width="48" Height="48" VerticalAlignment="Center">
            <controls:MaterialStateLayer x:Name="StateLayer" Width="40" Height="40" CornerRadius="20" Background="{TemplateBinding BorderBrush}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="FocusRing" Width="42" Height="42" CornerRadius="21" BorderThickness="3"
                    BorderBrush="{DynamicResource M3.SecondaryBrush}" IsVisible="False" IsHitTestVisible="False" />
            <controls:MaterialCheckboxCanvas>
            <controls:MaterialCheckboxBox x:Name="Box" CornerRadius="2" BorderThickness="2"
                    BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" />
            <controls:MaterialCheckboxGlyph x:Name="Check" Value="{TemplateBinding IsChecked}"
                  CheckBrush="{DynamicResource M3.OnPrimaryBrush}" />
            </controls:MaterialCheckboxCanvas>
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" TextWrapping="Wrap"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" />
            <TextBlock x:Name="ErrorLabel" Text="{TemplateBinding ErrorText}" IsVisible="{TemplateBinding IsError}"
                       Foreground="{DynamicResource M3.ErrorBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked, ^:indeterminate">
      <Setter Property="Background" Value="{DynamicResource M3.PrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource M3.PrimaryBrush}" />
    </Style>
    <Style Selector="^:error:not(:disabled),^:error:modal-paint-enabled">
      <Setter Property="BorderBrush" Value="{DynamicResource M3.ErrorBrush}" />
    </Style>
    <Style Selector="^:error:checked:not(:disabled),^:error:checked:modal-paint-enabled, ^:error:indeterminate:not(:disabled), ^:error:indeterminate:modal-paint-enabled">
      <Setter Property="Background" Value="{DynamicResource M3.ErrorBrush}" />
    </Style>
    <Style Selector="^:error:not(:disabled) /template/ controls|MaterialCheckboxGlyph#Check,^:error:modal-paint-enabled /template/ controls|MaterialCheckboxGlyph#Check">
      <Setter Property="CheckBrush" Value="{DynamicResource M3.OnErrorBrush}" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled)">
      <Setter Property="BorderBrush" Value="{DynamicResource M3.OnSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled):checked, ^:disabled:not(:modal-paint-enabled):indeterminate">
      <Setter Property="Background" Value="{DynamicResource M3.OnSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled) /template/ controls|MaterialCheckboxBox#Box">
      <Setter Property="ColorAlpha" Value="{DynamicResource M3.DisabledForegroundOpacity}" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled) /template/ controls|MaterialCheckboxGlyph#Check">
      <Setter Property="CheckBrush" Value="{DynamicResource M3.SurfaceBrush}" />
    </Style>
  </ControlTheme>
  <!-- RadioButtonTokens v0_117: 20 icon, 40 state layer; 48 target. -->
  <ControlTheme x:Key="{x:Type controls:MaterialRadioButton}" TargetType="controls:MaterialRadioButton" BasedOn="{StaticResource M3.SelectionInteraction}">
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="BorderBrush" Value="{DynamicResource M3.OnSurfaceVariantBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource M3.BodyLargeFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource M3.BodyLargeFontSize}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="48,*" Background="Transparent">
          <Grid Width="48" Height="48" VerticalAlignment="Center">
            <controls:MaterialStateLayer x:Name="StateLayer" Width="40" Height="40" CornerRadius="20" Background="{TemplateBinding BorderBrush}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="FocusRing" Width="42" Height="42" CornerRadius="21" BorderThickness="3"
                    BorderBrush="{DynamicResource M3.SecondaryBrush}" IsVisible="False" IsHitTestVisible="False" />
            <controls:MaterialRadioRing x:Name="Ring" Width="20" Height="20" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}" />
            <controls:MaterialCircleGlyph x:Name="Dot" Width="20" Height="20" Fill="{TemplateBinding BorderBrush}" />
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" TextWrapping="Wrap"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" />
            <TextBlock x:Name="ErrorLabel" Text="{TemplateBinding ErrorText}" IsVisible="{TemplateBinding IsError}"
                       Foreground="{DynamicResource M3.ErrorBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked">
      <Setter Property="BorderBrush" Value="{DynamicResource M3.PrimaryBrush}" />
    </Style>
    <Style Selector="^:error:not(:disabled),^:error:modal-paint-enabled">
      <Setter Property="BorderBrush" Value="{DynamicResource M3.ErrorBrush}" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled)">
      <Setter Property="BorderBrush" Value="{DynamicResource M3.SelectionDisabledOnSurfaceBrush}" />
    </Style>
  </ControlTheme>
  <!-- SwitchTokens v0_210: 52x32 track, 2 outline, 16/24 handle; 48 target. -->
  <ControlTheme x:Key="{x:Type controls:MaterialSwitch}" TargetType="controls:MaterialSwitch" BasedOn="{StaticResource M3.SelectionInteraction}">
    <Setter Property="MinWidth" Value="52" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Background" Value="{DynamicResource M3.SurfaceContainerHighestBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource M3.OutlineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource M3.BodyLargeFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource M3.BodyLargeFontSize}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="52,*" Background="Transparent">
          <Grid Width="52" Height="48" VerticalAlignment="Center">
            <controls:MaterialElevationBorder x:Name="Track" Width="52" Height="32" CornerRadius="16" BorderThickness="2"
                    BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" />
            <controls:MaterialElevationBorder x:Name="DisabledTrackOutline" Width="52" Height="32" CornerRadius="16" BorderThickness="2"
                    BorderBrush="{TemplateBinding BorderBrush}" IsVisible="False" IsHitTestVisible="False" />
            <Canvas x:Name="PART_SwitchKnob" Width="20" Height="48" HorizontalAlignment="Left">
              <Grid x:Name="PART_MovingKnobs" Width="32" Height="48" UseLayoutRounding="False">
                <controls:MaterialStateLayer x:Name="StateLayer" Width="40" Height="40" CornerRadius="20" Background="{TemplateBinding BorderBrush}" Opacity="0" IsHitTestVisible="False" />
                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource M3.OutlineBrush}" />
                <ContentPresenter x:Name="OffIcon" Width="16" Height="16" FontSize="16" LineHeight="16" LetterSpacing="0" Content="{TemplateBinding OffIcon}"
                                  Foreground="{DynamicResource M3.SurfaceContainerHighestBrush}" IsHitTestVisible="False"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                <ContentPresenter x:Name="OnIcon" Width="16" Height="16" FontSize="16" LineHeight="16" LetterSpacing="0" Content="{TemplateBinding OnIcon}"
                                  Foreground="{DynamicResource M3.OnPrimaryContainerBrush}" IsVisible="False" IsHitTestVisible="False"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
              </Grid>
            </Canvas>
            <Border x:Name="FocusRing" Width="60" Height="40" CornerRadius="20" BorderThickness="3"
                    BorderBrush="{DynamicResource M3.SecondaryBrush}" IsVisible="False" IsHitTestVisible="False" />
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" TextWrapping="Wrap"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" />
            <ContentPresenter x:Name="PART_OffContentPresenter" Content="{TemplateBinding OffContent}"
                              ContentTemplate="{TemplateBinding OffContentTemplate}" TextWrapping="Wrap" />
            <ContentPresenter x:Name="PART_OnContentPresenter" Content="{TemplateBinding OnContent}"
                              ContentTemplate="{TemplateBinding OnContentTemplate}" TextWrapping="Wrap" IsVisible="False" />
            <TextBlock x:Name="ErrorLabel" Text="{TemplateBinding ErrorText}" IsVisible="{TemplateBinding IsError}"
                       Foreground="{DynamicResource M3.ErrorBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource M3.PrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource M3.PrimaryBrush}" />
    </Style>
    <Style Selector="^:off-icon /template/ Ellipse#Thumb">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="^:checked /template/ ContentPresenter#OffIcon">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:checked /template/ ContentPresenter#OnIcon">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#Thumb">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Fill" Value="{DynamicResource M3.OnPrimaryBrush}" />
    </Style>
    <Style Selector="^:error:not(:disabled),^:error:modal-paint-enabled">
      <Setter Property="BorderBrush" Value="{DynamicResource M3.ErrorBrush}" />
    </Style>
    <Style Selector="^:error:checked:not(:disabled),^:error:checked:modal-paint-enabled">
      <Setter Property="Background" Value="{DynamicResource M3.ErrorBrush}" />
    </Style>
    <Style Selector="^:unchecked:pointerover:not(:error), ^:unchecked:pressed:not(:error), ^:unchecked:focus-visible:not(:error)">
      <Setter Property="BorderBrush" Value="{DynamicResource M3.OutlineBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Ellipse#Thumb">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
    </Style>
    <Style Selector="^:unchecked:pointerover /template/ Ellipse#Thumb, ^:unchecked:pressed /template/ Ellipse#Thumb, ^:unchecked:focus-visible /template/ Ellipse#Thumb">
      <Setter Property="Fill" Value="{DynamicResource M3.OnSurfaceVariantBrush}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ Ellipse#Thumb, ^:checked:pressed /template/ Ellipse#Thumb, ^:checked:focus-visible /template/ Ellipse#Thumb">
      <Setter Property="Fill" Value="{DynamicResource M3.PrimaryContainerBrush}" />
    </Style>
    <Style Selector="^:checked /template/ ContentPresenter#PART_OffContentPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:checked /template/ ContentPresenter#PART_OnContentPresenter">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled)">
      <Setter Property="BorderBrush" Value="{DynamicResource M3.SwitchDisabledOnSurfaceContainerBrush}" />
      <Setter Property="Background" Value="{DynamicResource M3.SwitchDisabledHighestContainerBrush}" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled):checked">
      <Setter Property="Background" Value="{DynamicResource M3.SwitchDisabledOnSurfaceContainerBrush}" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled):checked /template/ Border#Track">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled):unchecked /template/ Border#Track">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled):unchecked /template/ Border#DisabledTrackOutline">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled) /template/ Ellipse#Thumb">
      <Setter Property="Fill" Value="{DynamicResource M3.SwitchDisabledOnSurfaceForegroundBrush}" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled):checked /template/ ContentPresenter#OnIcon">
      <Setter Property="Foreground" Value="{DynamicResource M3.SwitchDisabledOnSurfaceForegroundBrush}" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled):unchecked /template/ ContentPresenter#OffIcon">
      <Setter Property="Foreground" Value="{DynamicResource M3.SwitchDisabledHighestForegroundBrush}" />
    </Style>
    <Style Selector="^:disabled:not(:modal-paint-enabled):checked /template/ Ellipse#Thumb">
      <Setter Property="Fill" Value="{DynamicResource M3.SurfaceBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
