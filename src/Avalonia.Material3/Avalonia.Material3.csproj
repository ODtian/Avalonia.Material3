<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>$(Material3Version)</Version>
    <Description>Material 3 Expressive controls and theme inputs for Avalonia.</Description>
    <RepositoryUrl>https://github.com/ODtian/Avalonia.Material3</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <Authors>ODtian</Authors>
    <PackageProjectUrl>https://github.com/ODtian/Avalonia.Material3</PackageProjectUrl>
    <PackageReleaseNotes>preview.7: shared DPI-aware snapshot rendering and consistent content clipping, elevation overflow, and live presentation boundaries. See CHANGELOG.md.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="MaterialColorUtilities" Version="0.3.0" ExcludeAssets="analyzers" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <AvaloniaResource Include="Assets/Icons/*.ttf" />
    <AvaloniaResource Include="Assets/Icons/*.codepoints" />
    <AvaloniaResource Include="Assets/Icons/manifest.json" />
    <EmbeddedResource Include="Assets/Ripple/ripple.sksl" LogicalName="M3.PatternedRipple.sksl" />
    <None Update="Assets/Icons/LICENSE.txt;Assets/Icons/manifest.json;Assets/Icons/*.codepoints" Pack="true" PackagePath="licenses/MaterialSymbols/" />
  </ItemGroup>
</Project>

